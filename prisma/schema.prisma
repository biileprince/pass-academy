generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TUTOR
  MENTOR
  ADMIN
}

enum SessionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseCategory {
  MATH
  ENGLISH
  SCIENCE
  MEDIA
  OTHER
}

enum WebinarStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  NO_SHOW
  CANCELLED
}

// ─── Auth (NextAuth v5 + Prisma Adapter) ──────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  profile              Profile?
  mentorProfile        MentorProfile?
  tutorProfile         TutorProfile?
  taughtCourses        Course[]         @relation("TutorCourses")
  enrollments          Enrollment[]
  bookedSessions       MentorSession[]  @relation("StudentSessions")
  mentorSessions       MentorSession[]  @relation("MentorSessions")
  webinarRegistrations WebinarRegistration[]
  sentMessages         Message[]        @relation("SentMessages")
  receivedMessages     Message[]        @relation("ReceivedMessages")
  lessonProgress       LessonProgress[]
  careerProfile        CareerProfile?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// ─── Profiles ─────────────────────────────────────────────────────────────────

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  avatarUrl   String?
  phone       String?
  country     String?
  school      String?
  gradeLevel  String?
  interests   Json?
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model MentorProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  headline        String
  expertise       Json?
  subjects        Json?
  yearsExperience Int            @default(0)
  hourlyRate      Float?
  currency        String         @default("USD")
  timezone        String         @default("UTC")
  isApproved      Boolean        @default(false)
  isAvailable     Boolean        @default(true)
  languages       Json?          @default("[\"English\"]")
  rating          Float?
  reviewCount     Int            @default(0)
  availability    Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions MentorSession[]

  @@map("mentor_profiles")
}

model TutorProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  headline        String
  bio             String?
  expertise       Json?
  subjects        Json?
  yearsExperience Int            @default(0)
  qualifications  Json?
  isApproved      Boolean        @default(false)
  isActive        Boolean        @default(true)
  languages       Json?          @default("[\"English\"]")
  rating          Float?
  reviewCount     Int            @default(0)
  studentsCount   Int            @default(0)
  coursesCount    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tutor_profiles")
}

// ─── Mentorship ───────────────────────────────────────────────────────────────

model MentorSession {
  id              String        @id @default(cuid())
  studentId       String
  mentorId        String
  mentorProfileId String
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int           @default(60)
  status          SessionStatus @default(PENDING)
  meetingUrl      String?
  notes           String?
  studentRating   Int?
  studentReview   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  student       User          @relation("StudentSessions", fields: [studentId], references: [id])
  mentor        User          @relation("MentorSessions", fields: [mentorId], references: [id])
  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id])
  messages      Message[]

  @@index([studentId])
  @@index([mentorId])
  @@index([scheduledAt])
  @@map("mentor_sessions")
}

// ─── Courses & Learning Hub ───────────────────────────────────────────────────

model Course {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String
  shortDesc     String?
  thumbnailUrl  String?
  category      CourseCategory
  level         CourseLevel    @default(BEGINNER)
  tags          Json?
  isPublished   Boolean        @default(false)
  isFeatured    Boolean        @default(false)
  isFree        Boolean        @default(true)
  price         Float?
  currency      String         @default("USD")
  authorId      String
  tutorId       String
  totalDuration Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tutor       User         @relation("TutorCourses", fields: [tutorId], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([category])
  @@index([slug])
  @@index([tutorId])
  @@map("courses")
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  slug        String
  description String?
  videoUrl    String?
  duration    Int      @default(0)
  order       Int
  isPublished Boolean  @default(false)
  isFree      Boolean  @default(false)
  downloadUrl String?
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([courseId, slug])
  @@unique([courseId, order])
  @@index([courseId])
  @@map("lessons")
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  progress    Float            @default(0)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean   @default(false)
  watchedSecs Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ─── Webinars & Events ────────────────────────────────────────────────────────

model Webinar {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String
  thumbnailUrl String?
  hostId       String
  hostName     String
  scheduledAt  DateTime
  durationMins Int           @default(60)
  status       WebinarStatus @default(SCHEDULED)
  meetingUrl   String?
  replayUrl    String?
  maxAttendees Int?
  isPublic     Boolean       @default(true)
  isFree       Boolean       @default(true)
  tags         Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  registrations WebinarRegistration[]

  @@index([scheduledAt])
  @@index([slug])
  @@map("webinars")
}

model WebinarRegistration {
  id           String             @id @default(cuid())
  userId       String
  webinarId    String
  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  webinar Webinar @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([userId, webinarId])
  @@map("webinar_registrations")
}

// ─── Messaging ────────────────────────────────────────────────────────────────

model Message {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  sessionId  String?
  content    String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  sender   User           @relation("SentMessages", fields: [senderId], references: [id])
  receiver User           @relation("ReceivedMessages", fields: [receiverId], references: [id])
  session  MentorSession? @relation(fields: [sessionId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([sessionId])
  @@map("messages")
}

// ─── Phase 2 Stubs ────────────────────────────────────────────────────────────

model CareerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  resumeUrl      String?
  linkedinUrl    String?
  targetRole     String?
  skills         Json?
  workExperience Json?
  education      Json?
  isVisible      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_profiles")
}
